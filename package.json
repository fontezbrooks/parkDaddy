{
  "name": "parkdaddy",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas": "eas build --platform ios",
    "eas:submit": "eas submit --platform ios",
    "eas:dev": "eas build --platform ios --profile development",
    "eas:prod": "eas build --platform ios --profile production",
    "publish": "pnpm run prebuild && pnpm run eas:prod && pnpm run eas:submit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "test": "jest",
    "prepare": "husky",
    "eas-build-pre-install": "npm install -g pnpm@12.18.0"
  },
  "dependencies": {
    "@clerk/clerk-expo": "~2.19.33",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.2.0",
    "convex": "^1.34.1",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-server-sdk": "^6.1.0",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "utf-8-validate": "^5.0.10"
  },
  "devDependencies": {
    "@sentry/cli": "2.55.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.1.0",
    "eslint": "^9.7.0",
    "eslint-config-expo": "~10.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.5.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@clerk/clerk-js": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@clerk/clerk-react": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@clerk/shared": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  },
  "packageManager": "pnpm@12.18.0"
}
